{
	"geode": "5.11.2",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "tudeptraiii.cheat-indicator",
	"name": "Cheat Indicator Pro",
	"version": "v1.1.0",
	"developer": "tudeptraiii",
	"description": "Cham xanh chuyen do khi phat hien gian lan. Luu bao cao moi run de kiem tra level nop len.",
	"dependencies": {
		"geode.node-ids": ">=v1.23.3"
	},
	"settings": {
		"enabled": {
			"type": "bool",
			"name": "Bat chi bao",
			"default": true
		},
		"dot-size": {
			"type": "float",
			"name": "Kich thuoc cham",
			"default": 5.0,
			"min": 2.0,
			"max": 20.0,
			"control": {
				"slider": true
			}
		},
		"dot-opacity": {
			"type": "float",
			"name": "Do dam cham",
			"default": 1.0,
			"min": 0.1,
			"max": 1.0,
			"control": {
				"slider": true
			}
		},
		"dot-corner": {
			"type": "string",
			"name": "Vi tri cham",
			"default": "top-left",
			"one-of": [
				"top-left",
				"top-right",
				"bottom-left",
				"bottom-right"
			]
		},
		"tps-limit": {
			"type": "float",
			"name": "Gioi han TPS",
			"default": 240.0,
			"min": 60.0,
			"max": 480.0
		},
		"red-seconds": {
			"type": "float",
			"name": "Giu mau do (giay)",
			"default": 5.0,
			"min": 1.0,
			"max": 60.0
		},
		"check-timescale": {
			"type": "bool",
			"name": "Kiem tra time scale cua game",
			"default": true
		},
		"check-noclip": {
			"type": "bool",
			"name": "Phat hien noclip (heuristic)",
			"default": true
		},
		"scan-mods": {
			"type": "bool",
			"name": "Quet mod hack dang bat",
			"default": true
		},
		"extra-hack-ids": {
			"type": "string",
			"name": "ID mod hack them (cach nhau dau phay, khong dau cach)",
			"default": ""
		},
		"save-report": {
			"type": "bool",
			"name": "Luu bao cao khi qua level",
			"default": true
		}
	}
}